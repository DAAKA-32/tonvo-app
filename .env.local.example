# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (Whisper transcription)
OPENAI_API_KEY=

# Anthropic (Claude analysis)
ANTHROPIC_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_TEAM_YEARLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Admin
ADMIN_EMAILS=admin@example.com

# Plan overrides (format: email:plan,email:plan — bypasses Stripe for these accounts)
PLAN_OVERRIDES=

# App URL (used for Stripe redirects — auto-detected on Vercel if unset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis (rate limiting — optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meta Pixel + Conversions API (Meta Ads tracking)
# Get pixel id from Meta Business Manager → Events Manager → Data Sources
NEXT_PUBLIC_FB_PIXEL_ID=
# Server access token (Meta Business Manager → Events Manager → Settings → Conversions API → Generate Access Token)
FB_CAPI_ACCESS_TOKEN=
# Optional: test event code from Events Manager → Test Events panel — set during initial verification, remove for production
FB_CAPI_TEST_EVENT_CODE=
